# TaxIntuitive — environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# IMPORTANT: `.env` is gitignored. Never commit real keys.
# The EXPO_PUBLIC_ prefix means these values are embedded in the app bundle, which is correct
# for the anon key (it is designed to be public and is constrained by row-level security).
# NEVER put the service_role key in this file — it belongs only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The app runs fully without these: it stays in guest mode with bundled offline content.
# They are required only for accounts, cloud sync, and Quiz Duo.

# Enable only after configuring the corresponding Supabase provider and email delivery.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_EMAIL_SIGNUP_ENABLED=false
